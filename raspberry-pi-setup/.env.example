# Supabase Cloud Configuration
SUPABASE_URL=https://your-project-id.supabase.co
# Use your service_role_key or publishable/anon key from Supabase project settings
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Hardware & Camera
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
FRAME_SCALE=0.25

# Recognition Parameters
MATCH_THRESHOLD=0.45
AMBIGUITY_RATIO=0.85
COOLDOWN_SECONDS=30

# Late Cutoff (24h format: 9:00 AM)
CUTOFF_HOUR=9
CUTOFF_MINUTE=0

# Periodic Refresh (sync new faces every 300s / 5min)
STUDENT_SYNC_INTERVAL_SEC=300

# School Gate info
GATE_NAME=Main School Gate
CAPTURE_MODE=gate-mode

# Output
SHOW_WINDOW=true
ENABLE_AUDIO=true
