
# Backend Configuration (Vite prefixes required for client-side env vars)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY

# Edge Function Secrets (set via `supabase secrets set` or hosting env)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# GEMINI_API_KEY=your_gemini_api_key
# RESEND_API_KEY=your_resend_api_key

# Jarvis AI Monitoring & Assistant (Dedicated Supabase & Gemini)
VITE_JARVIS_SUPABASE_URL=https://your-jarvis-ref.supabase.co
VITE_JARVIS_SUPABASE_ANON_KEY=your_jarvis_anon_key
JARVIS_SUPABASE_SERVICE_KEY=your_jarvis_service_role_key
VITE_GEMINI_API_KEY=your_gemini_api_key
