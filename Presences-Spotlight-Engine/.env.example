# ─── Presences Spotlight AI Configuration ─────────────────────────────────────

# 1. Supabase Cloud Credentials (From Presences Project Settings)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# 2. Camera Video Stream
# Use "0" for USB / Laptop Webcam testing
# Use RTSP URL for PoE IP Bullet Camera (e.g. Hikvision / Dahua / Uniview)
RTSP_URL=0
# RTSP_URL=rtsp://admin:password@192.168.1.50:554/Streaming/Channels/101

# 3. Camera Resolution & Downscale
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
TARGET_FPS=30
FRAME_SCALE=0.5

# 4. Recognition & Safeguards
MATCH_THRESHOLD=0.42
AMBIGUITY_RATIO=0.82
CONSENSUS_FRAMES_REQUIRED=3
CONSENSUS_WINDOW_SECONDS=1.5
MIN_FACE_SIZE_PX=60

# 5. Timing & Cutoffs
COOLDOWN_SECONDS=60
CUTOFF_HOUR=9
CUTOFF_MINUTE=0
STUDENT_SYNC_INTERVAL_SEC=300
GATE_NAME=Main Building Gate - Spotlight 1

# 6. Display & Audio
SHOW_WINDOW=true
FULLSCREEN_KIOSK=false
ENABLE_AUDIO=true
