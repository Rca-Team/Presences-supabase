# Supabase Project Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-key

# Camera Configuration
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
FRAME_SCALE=0.25

# Face Recognition Parameters
MATCH_THRESHOLD=0.42
AMBIGUITY_RATIO=0.80
MIN_AUTO_MARK_CONF=0.70
STABILITY_HITS=3
STABILITY_WINDOW_SEC=2.5

# Anti-Spoofing & Liveness
ENABLE_LIVENESS_CHECK=true
MIN_EAR_VARIANCE=0.002

# Attendance Timing
COOLDOWN_SECONDS=30
ON_TIME_HOUR=8
ON_TIME_MINUTE=0
GRACE_CUTOFF_HOUR=8
GRACE_CUTOFF_MINUTE=45
LATE_CUTOFF_HOUR=9
LATE_CUTOFF_MINUTE=0

# Terminal Info
GATE_NAME=Main School Terminal
CAPTURE_MODE=scanner
SOURCE=scanner
AUTO_TRIGGER_PARENT_ALERTS=true

# Display & Audio
SHOW_WINDOW=true
ENABLE_AUDIO=true
ENABLE_VOICE_GREETING=true
